{
  "name": "docunexa-backend",
  "version": "1.0.0",
  "description": "DocuNexa Enterprise Document Intelligence Platform - Node.js REST API & Background Services",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src",
    "test": "jest --config jest.config.json",
    "migrate": "node dist/database/migrations/migrate.js",
    "migrate:drill": "node --loader ts-node/esm scripts/verify-migrations-and-rollbacks.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "ai:eval": "node scripts/run-ai-evaluation.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@types/compression": "^1.8.1",
    "@types/mailparser": "^3.9.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.15",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "imapflow": "^2.4.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.39",
    "mongodb": "^7.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
