# ==============================================================================
# DocuNexa Enterprise Backend Environment Configuration Template
# ==============================================================================
# Security Policy:
# 1. Never commit production .env files containing live credentials to version control.
# 2. JWT_SECRET and AUDIT_HMAC_SECRET MUST be generated using cryptographically secure random bytes:
#    e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Minimum length for secrets is 32 characters. Missing or weak secrets will halt startup.
# ==============================================================================

NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# PostgreSQL 16 Database Sandbox Configuration
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_DATABASE=docunexa_sandbox
DB_SSL=false
DB_MAX_POOL=20

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=docunexa_sandbox
POSTGRES_SSL=false
POSTGRES_MAX_POOL=20

# JWT & Authentication Configuration
# MUST be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_characters_high_entropy_secret_hex
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=docunexa-auth
JWT_AUDIENCE=docunexa-platform

# Cryptographic Audit Signing Key (SHA-256 HMAC for immutable audit_trail_events)
# MUST be at least 32 characters.
AUDIT_HMAC_SECRET=replace_with_at_least_32_characters_high_entropy_hmac_hex

# Rate Limiting Store Configuration ('postgres' or 'memory')
RATE_LIMIT_STORE=postgres
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Reverse Proxy Trust Configuration
TRUST_PROXY=false

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Storage Driver Configuration ('s3', 'local', 'memory')
# In production, 's3' is mandatory. In tests, 'memory' is permitted.
STORAGE_DRIVER=s3

# S3 / MinIO Compatible Object Storage Configuration
# Local MinIO: S3_ENDPOINT=http://127.0.0.1:9000 | Container network: http://docunexa-minio:9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=docunexa-documents
S3_ACCESS_KEY_ID=docunexa_minio_admin
S3_SECRET_ACCESS_KEY=replace_with_strong_minio_password
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=data/storage

# Malware Scanning Engine Configuration ('clamav' or 'mock')
# In production, 'clamav' is mandatory. In tests, 'mock' is permitted.
SCANNER_TYPE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# SMTP Configuration for Login Alerts & Verification
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DocNexa Security <no-reply@docnexa.io>

# Gemini AI & Multimodal OCR Configuration
GEMINI_API_KEY=
OCR_ENGINE=gemini # 'gemini', 'tesseract', or 'mock'

# Redis & Durable BullMQ Queue Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_PREFIX=docunexa

# TOTP MFA Encryption Key (32-byte hex / 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENC_KEY=replace_with_64_character_hex_encryption_key

# MongoDB Derived-Data Store (Sprint 5)
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=docunexa
DERIVED_STORE_MODE=dual # 'postgres', 'dual', or 'mongo'

# Inbound Email Intake (IMAP) (Sprint 5)
EMAIL_INTAKE_ENABLED=false
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=intake@docunexa.io
IMAP_PASS=replace_with_imap_password

