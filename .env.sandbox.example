# ==============================================================================
# DocuNexa PostgreSQL 16 Sandbox Environment Secret Template
# ==============================================================================
# 1. Copy this file to '.env.sandbox' in the repository root:
#    cp .env.sandbox.example .env.sandbox
# 2. Populate with strong passwords for your local sandbox instance.
# 3. DO NOT commit '.env.sandbox' to Git (it is excluded via .gitignore).
# ==============================================================================

# Strong password for superuser 'postgres' inside the sandbox container
SANDBOX_POSTGRES_PASSWORD=replace_with_strong_sandbox_superuser_password

# Strong password for dedicated least-privilege application role 'docunexa_app'
SANDBOX_APP_PASSWORD=replace_with_strong_sandbox_app_password

# Sandbox service credentials used by the nested application Compose file
SANDBOX_REDIS_PASSWORD=replace_with_strong_sandbox_redis_password
SANDBOX_MONGO_PASSWORD=replace_with_strong_sandbox_mongo_password
SANDBOX_MINIO_USER=replace_with_sandbox_minio_user
SANDBOX_MINIO_PASSWORD=replace_with_strong_sandbox_minio_password

# Root sandbox Compose MinIO credential
MINIO_ROOT_USER=docunexa_minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
